{
  "name": "matteo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A searchable 3D book discovery cloud: books as points positioned by subject and author similarity.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "fetch": "vite-node scripts/fetch-openlibrary.ts",
    "corpus:merge": "vite-node scripts/merge-corpus.ts",
    "neighbors": "vite-node scripts/build-neighbors.ts"
  },
  "dependencies": {
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "fuse.js": "7.5.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "three": "0.185.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.1",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react": "6.0.4",
    "happy-dom": "20.11.1",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vite-node": "6.0.0",
    "vitest": "4.1.10"
  }
}
